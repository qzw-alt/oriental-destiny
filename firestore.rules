rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 用户资料：只能读写自己的
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 解梦记录：只能读写自己的
    match /dream_readings/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // 测算报告：只能读写自己的
    match /instant_reports/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // 订单：只能读自己的；写入只由 Cloud Functions（Admin SDK 绕过本规则）
    match /orders/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // 邮箱捕获：客户端不可读写，只由 Cloud Functions 写入
    match /leads/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // 生日问答测试：匿名答卷与聚合计数
    // 客户端完全不可达，只由 Cloudflare Worker 用服务账号读写。
    // 服务端只存 MM-DD + 年龄带 + 答案数组，不含出生年份、邮箱或 uid。
    match /quiz_responses/{docId} {
      allow read: if false;
      allow write: if false;
    }
    match /quiz_stats/{docId} {
      allow read: if false;
      allow write: if false;
    }
  }
}
